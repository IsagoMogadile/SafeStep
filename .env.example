# SafeStep environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env` itself.

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Used only by tool/seed_super_admin.dart (never used by the app itself).
# Get it from: Supabase Dashboard -> Project Settings -> API -> "service_role" secret key
SUPABASE_SERVICE_ROLE_KEY=

GOOGLE_MAPS_API_KEY_ANDROID=
GOOGLE_MAPS_API_KEY_IOS=

# Edge Function endpoint used by the SafeStep AI Assistant (see supabase/functions)
AI_ASSISTANT_FUNCTION_URL=
